    {
      "name": "parkings of a city (Poitiers)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"parkings of a city (Poitiers) - status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"parkings of a city (Poitiers) - response is JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"parkings of a city (Poitiers) - body is an array\", function () {\n    var json = pm.response.json();\n    pm.expect(json).to.be.an(\"array\");\n});\n\npm.test(\"parkings of a city (Poitiers) - array is not empty\", function () {\n    var json = pm.response.json();\n    pm.expect(json.length).to.be.above(0);\n});\n\npm.test(\"parkings of a city (Poitiers) - each item has required fields\", function () {\n    var json = pm.response.json();\n    json.forEach(function(parking) {\n        pm.expect(parking).to.have.property(\"id\");\n        pm.expect(parking).to.have.property(\"name\");\n        pm.expect(parking).to.have.property(\"address\");\n        pm.expect(parking).to.have.property(\"capacity\");\n        pm.expect(parking).to.have.property(\"city\");\n        pm.expect(parking).to.have.property(\"country\");\n    });\n});\n\npm.test(\"parkings of a city (Poitiers) - city is Poitiers\", function () {\n    var json = pm.response.json();\n    json.forEach(function(parking) {\n        pm.expect(parking.city).to.equal(\"Poitiers\");\n    });\n});\n\npm.test(\"parkings of a city (Poitiers) - capacity is a positive number\", function () {\n    var json = pm.response.json();\n    json.forEach(function(parking) {\n        pm.expect(parking.capacity).to.be.a(\"number\").and.above(0);\n    });\n});\n\npm.test(\"parkings of a city (Poitiers) - response time < 2000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});"
            ]
          }
        }
      ],
